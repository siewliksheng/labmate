# Anthropic backend (default) -- required unless LLM_BACKEND=ollama below
ANTHROPIC_API_KEY=

# Local backend, no API key or cost -- see src/labmate/llm_client.py for
# the honest tradeoff (real for exercising the harness, weaker for actual
# safety-reasoning quality). Requires `ollama serve` running locally and
# the model pulled first, e.g.: ollama pull llama3.1
# LLM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

DATABASE_URL=postgresql://localhost/labmate
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional -- raises PubMed/NCBI E-utilities rate limit from 3req/sec to
# 10req/sec. Free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
